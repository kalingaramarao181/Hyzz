{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "HYZZ_APP_VARIANT": "customer"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleCustomerRelease"
      }
    },
    "preview-driver": {
      "distribution": "internal",
      "env": {
        "HYZZ_APP_VARIANT": "driver"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDriverRelease"
      }
    },
    "production": {
      "env": {
        "HYZZ_APP_VARIANT": "customer"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleCustomerRelease"
      }
    }
  }
}
